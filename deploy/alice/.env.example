# scripts/preparar.sh copies this file to deploy/alice/.env and fills AIRI_TLS_NAMES.
# Compose reads .env next to compose.yaml.
# .env is ignored by git. Keep passwords only there.

# Ports of airi-web on the host. Do not use 8081: TalkingHead keeps it.
AIRI_HTTP_PORT=4173
AIRI_HTTPS_PORT=4443

# Names and IPs of the HTTPS certificate, comma separated. localhost and 127.0.0.1 are always in.
# After a change, run scripts/preparar.sh again and restart airi-web.
AIRI_TLS_NAMES=192.0.2.10,airi.example.com

# WebSocket listener of the MQTT broker (host:port), as seen from the container.
# host.docker.internal is this machine. With the `broker` profile, use mosquitto:9001.
# With the `bridge` profile, use mqtt-bridge:9001.
AIRI_MQTT_WS_UPSTREAM=host.docker.internal:9001
# TalkingHead server of the mirror, for example http://192.0.2.10:8081. A motion file (FBX) that
# deploy/alice/animacoes does not have is fetched from it, at the same path (animations/, animations_arkit/, poses/).
# Empty: only deploy/alice/animacoes and the motions that AIRI ships.
AIRI_TALKINGHEAD_UPSTREAM=

# `bridge` profile: the NeoAlice broker (MQTT, not WebSocket). The bridge only reads from it.
NEOALICE_MQTT_HOST=192.0.2.14
NEOALICE_MQTT_PORT=1883
NEOALICE_MQTT_USERNAME=
NEOALICE_MQTT_PASSWORD=
NEOALICE_MQTT_TOPICS=neoalice/#

# Services that the browser calls through airi-web. Each value is a URL without a path.
# A service on another machine: use its IP, for example http://192.0.2.14:8880.
# In AIRI, the base URLs are https://<host>:4443/proxy/llm/v1/, .../proxy/tts/v1/, and .../proxy/stt/v1/.
AIRI_LLM_UPSTREAM=http://host.docker.internal:11434
AIRI_TTS_UPSTREAM=http://host.docker.internal:8880
AIRI_STT_UPSTREAM=http://host.docker.internal:9100
# Path of the upstream that receives the audio. Use /inference for a Whisper server without the
# OpenAI API. Keep /v1/audio/transcriptions for an OpenAI compatible server.
AIRI_STT_TRANSCRIBE_PATH=/v1/audio/transcriptions

# NeoAlice API, for example the /chat and /tts routes. In AIRI: /proxy/neoalice/.
NEOALICE_API_UPSTREAM=http://host.docker.internal:8080
# Origins that can call the proxies from another origin, comma separated. "null" and "file://" are the desktop app,
# which loads its pages from file://. Empty: only the pages of this server.
AIRI_CORS_ORIGINS=null,file://

# Keys of the proxies. They stay in the container: the browser never gets them.
NEOALICE_API_KEY=
NVIDIA_API_KEY=

# First settings of AIRI. AIRI uses them where the browser has no setting of its own.
# Each one stays editable in the app. AIRI_DEFAULT_CHAT_PROVIDER: ollama, or nvidia with NVIDIA_API_KEY.
AIRI_DEFAULT_CHAT_PROVIDER=ollama
AIRI_DEFAULT_CHAT_MODEL=
AIRI_DEFAULT_TTS_MODEL=kokoro
AIRI_DEFAULT_TTS_VOICE=pf_dora
AIRI_DEFAULT_STT_MODEL=whisper-1
# The NeoAlice site of this avatar. Use a site of its own, for example airi-avatar, not the site of the
# mirror: NeoAlice sends cmd/tts/audio to one site. true connects the bridge on the first start.
AIRI_DEFAULT_NEOALICE_SITE=
AIRI_DEFAULT_NEOALICE_ENABLED=false
# silent (only text, mood, and gestures), neoalice-audio (plays cmd/tts/audio), or airi-voice.
# Use silent next to the mirror, so only one device speaks.
AIRI_DEFAULT_NEOALICE_SPEECH_MODE=silent
# true publishes each phrase of the avatar microphone as evt/audio on the site, like a satellite.
# NeoAlice answers with cmd/tts/audio. It needs AIRI_DEFAULT_NEOALICE_SPEECH_MODE=neoalice-audio.
AIRI_DEFAULT_NEOALICE_VOICE_INPUT=false
# UUID of the NeoAlice user of the phrases. Empty: NeoAlice uses its default user.
AIRI_DEFAULT_NEOALICE_USER_ID=
# Wake word of the microphone, for example Eva. Commas separate other spellings (Eva,Ewa).
# AIRI transcribes each phrase with the STT above, and sends only a phrase that starts with the word.
# The word also stops the speech of the avatar. Empty: every phrase goes to NeoAlice.
AIRI_DEFAULT_NEOALICE_WAKE_WORD=
# true publishes evt/state every 30 s, so NeoAlice lists the avatar as an active satellite.
AIRI_DEFAULT_NEOALICE_ANNOUNCE_STATE=false
# true: NeoAlice answers the chat, and AIRI is only its face, like the TalkingHead avatar.
# Typed text goes to NeoAlice as evt/stt/final. The LLM of AIRI does not answer.
AIRI_DEFAULT_NEOALICE_BRAIN=false
# Site where NeoAlice publishes the mood and the avatar commands. NeoAlice uses the mirror site.
AIRI_DEFAULT_NEOALICE_MOOD_SITE=magicmirror
# true: the avatar also says what Alice says on the mirror site (camera greetings, alarms). The avatar is the mirror.
# false while the TalkingHead avatar still runs on the mirror, or both speak.
AIRI_DEFAULT_NEOALICE_MIRROR_SPEECH=true

# alice-companion. With the `broker` profile, use mqtt://mosquitto:1883.
# With the `bridge` profile, use mqtt://mqtt-bridge:1883: the companion reads the NeoAlice topics
# there, and what it publishes stays on the bridge, out of the NeoAlice broker.
ALICE_COMPANION_MQTT_URL=mqtt://host.docker.internal:1883
ALICE_COMPANION_MQTT_USERNAME=
ALICE_COMPANION_MQTT_PASSWORD=
ALICE_COMPANION_INPUT_SITES=
ALICE_COMPANION_PUBLISH_SITE=companion
ALICE_COMPANION_PERSONA_ID=alice
ALICE_COMPANION_OWNER_PROFILE_ID=default
ALICE_COMPANION_TIME_ZONE=America/Sao_Paulo
