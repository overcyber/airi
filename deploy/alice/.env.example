# scripts/preparar.sh copies this file to deploy/alice/.env and fills AIRI_TLS_NAMES.
# Compose reads .env next to compose.yaml.
# .env is ignored by git. Keep passwords only there.

# Ports of airi-web on the host. Do not use 8081: TalkingHead keeps it.
AIRI_HTTP_PORT=4173
AIRI_HTTPS_PORT=4443

# Names and IPs of the HTTPS certificate, comma separated. localhost and 127.0.0.1 are always in.
# After a change, run scripts/preparar.sh again and restart airi-web.
AIRI_TLS_NAMES=192.0.2.10,airi.example.com

# WebSocket listener of the MQTT broker (host:port), as seen from the container.
# host.docker.internal is this machine. With the `broker` profile, use mosquitto:9001.
# With the `bridge` profile, use mqtt-bridge:9001.
AIRI_MQTT_WS_UPSTREAM=host.docker.internal:9001

# `bridge` profile: the NeoAlice broker (MQTT, not WebSocket). The bridge only reads from it.
NEOALICE_MQTT_HOST=192.0.2.14
NEOALICE_MQTT_PORT=1883
NEOALICE_MQTT_USERNAME=
NEOALICE_MQTT_PASSWORD=
NEOALICE_MQTT_TOPICS=neoalice/#

# Services that the browser calls through airi-web. Each value is a URL without a path.
# A service on another machine: use its IP, for example http://192.0.2.14:8880.
# In AIRI, the base URLs are https://<host>:4443/proxy/llm/v1/, .../proxy/tts/v1/, and .../proxy/stt/v1/.
AIRI_LLM_UPSTREAM=http://host.docker.internal:11434
AIRI_TTS_UPSTREAM=http://host.docker.internal:8880
AIRI_STT_UPSTREAM=http://host.docker.internal:9100
# Path of the upstream that receives the audio. Use /inference for a Whisper server without the
# OpenAI API. Keep /v1/audio/transcriptions for an OpenAI compatible server.
AIRI_STT_TRANSCRIBE_PATH=/v1/audio/transcriptions

# alice-companion. With the `broker` profile, use mqtt://mosquitto:1883.
# With the `bridge` profile, use mqtt://mqtt-bridge:1883: the companion reads the NeoAlice topics
# there, and what it publishes stays on the bridge, out of the NeoAlice broker.
ALICE_COMPANION_MQTT_URL=mqtt://host.docker.internal:1883
ALICE_COMPANION_MQTT_USERNAME=
ALICE_COMPANION_MQTT_PASSWORD=
ALICE_COMPANION_INPUT_SITES=
ALICE_COMPANION_PUBLISH_SITE=companion
ALICE_COMPANION_PERSONA_ID=alice
ALICE_COMPANION_OWNER_PROFILE_ID=default
ALICE_COMPANION_TIME_ZONE=America/Sao_Paulo
