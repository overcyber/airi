# airi-web: the AIRI stage-web build, with same-origin proxies for the services that the browser calls.
#
# The browser blocks http:// and ws:// calls from an https:// page (mixed content), and other origins
# need CORS. So the broker, the LLM, and the TTS are reached through this server, on the same address:
#   /mqtt         WebSocket MQTT broker     (AIRI_MQTT_WS_UPSTREAM, host:port)
#   /proxy/llm/   OpenAI compatible LLM     (AIRI_LLM_UPSTREAM, URL)
#   /proxy/tts/   OpenAI compatible TTS     (AIRI_TTS_UPSTREAM, URL)
#   /proxy/stt/   Speech to text            (AIRI_STT_UPSTREAM, URL, and AIRI_STT_TRANSCRIBE_PATH)
#   /proxy/nvidia/ NVIDIA NIM cloud API     (integrate.api.nvidia.com, NVIDIA_API_KEY)
#   /proxy/neoalice/ NeoAlice API            (NEOALICE_API_UPSTREAM, URL, and NEOALICE_API_KEY)
#   /airi-defaults.json first settings of AIRI, written by 40-airi-setup.sh from the environment
#   /models/      VRM files of deploy/alice/modelos, with a JSON list at /models/
#   /animations/  FBX and VRMA motions of deploy/alice/animacoes, with a JSON list at /animations/
#   /animations_arkit/, /poses/  the other two motion folders of the TalkingHead server, at the same paths

# CORS for the desktop app, which loads its pages from file:// (origin "null"). Only the origins of
# AIRI_CORS_ORIGINS get the header. 40-airi-setup.sh writes them to airi-cors-origins.map.
map $http_origin $airi_cors_origin {
  default "";
  include /etc/nginx/airi-cors-origins.map;
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  listen 443 ssl;
  http2 on;

  ssl_certificate     /etc/airi/tls/server.crt;
  ssl_certificate_key /etc/airi/tls/server.key;
  ssl_protocols       TLSv1.2 TLSv1.3;

  # Upstream names resolve at request time, so Nginx starts while a service is down.
  # 127.0.0.11 is the DNS of Docker. 40-airi-setup.sh replaces host.docker.internal with its IP.
  resolver 127.0.0.11 valid=30s ipv6=off;

  root  /usr/share/nginx/html;
  index index.html;

  # Imported models and speech audio can be large.
  client_max_body_size 200m;

  # The app bundle is about 24 MB of JavaScript, CSS, and JSON. Compression makes the first load faster.
  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml application/wasm;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }

  # The local CA of scripts/preparar.sh. Install it on a client device to trust the HTTPS address.
  location = /airi-local-ca.crt {
    default_type application/x-x509-ca-cert;
    alias /etc/airi/tls/ca.crt;
  }

  location /mqtt {
    set $airi_mqtt "${AIRI_MQTT_WS_UPSTREAM}";
    proxy_pass http://$airi_mqtt;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  # The upstream URLs have no path: the path after /proxy/llm/ goes to the upstream as it is.
  location /proxy/llm/ {
    include /etc/nginx/airi-cors.inc;
    set $airi_llm "${AIRI_LLM_UPSTREAM}";
    rewrite ^/proxy/llm/(.*)$ /$1 break;
    proxy_pass $airi_llm;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    # Ollama refuses a request with an Origin that is not in OLLAMA_ORIGINS (403).
    # The upstream sees this server, not the browser, so the Origin goes away.
    proxy_set_header Origin "";
    # Streaming responses go to the browser as they arrive.
    proxy_buffering off;
    proxy_read_timeout 600s;
  }

  location /proxy/tts/ {
    include /etc/nginx/airi-cors.inc;
    set $airi_tts "${AIRI_TTS_UPSTREAM}";
    rewrite ^/proxy/tts/(.*)$ /$1 break;
    proxy_pass $airi_tts;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header Origin "";
    proxy_buffering off;
    proxy_read_timeout 300s;
  }

  # AIRI sends the audio to <base URL>audio/transcriptions, as the OpenAI API does.
  # AIRI_STT_TRANSCRIBE_PATH is the path of the upstream for that call, for example /inference
  # for a Whisper server without the OpenAI API. Other paths go to the upstream as they are.
  location = /proxy/stt/v1/audio/transcriptions {
    include /etc/nginx/airi-cors.inc;
    set $airi_stt "${AIRI_STT_UPSTREAM}";
    rewrite ^ ${AIRI_STT_TRANSCRIBE_PATH} break;
    proxy_pass $airi_stt;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header Origin "";
    proxy_read_timeout 300s;
  }

  location /proxy/stt/ {
    include /etc/nginx/airi-cors.inc;
    set $airi_stt "${AIRI_STT_UPSTREAM}";
    rewrite ^/proxy/stt/(.*)$ /$1 break;
    proxy_pass $airi_stt;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header Origin "";
    proxy_read_timeout 300s;
  }

  # NVIDIA NIM (build.nvidia.com). It needs internet only when a request uses it.
  location /proxy/nvidia/ {
    include /etc/nginx/airi-cors.inc;
    set $nvidia_upstream https://integrate.api.nvidia.com;
    rewrite ^/proxy/nvidia/(.*)$ /$1 break;
    proxy_pass $nvidia_upstream;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host integrate.api.nvidia.com;
    proxy_set_header Origin "";
    # AIRI_NVIDIA_AUTH: 40-airi-setup.sh puts the key of NVIDIA_API_KEY here, when it is set.
    proxy_buffering off;
    proxy_read_timeout 600s;
  }

  # The NeoAlice API. The key stays on this server: the browser never sees it.
  location /proxy/neoalice/ {
    include /etc/nginx/airi-cors.inc;
    set $airi_neoalice "${NEOALICE_API_UPSTREAM}";
    rewrite ^/proxy/neoalice/(.*)$ /$1 break;
    proxy_pass $airi_neoalice;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header Origin "";
    # AIRI_NEOALICE_AUTH: 40-airi-setup.sh puts the key of NEOALICE_API_KEY here, when it is set.
    proxy_read_timeout 300s;
  }

  location = /airi-defaults.json {
    include /etc/nginx/airi-cors.inc;
    alias /etc/airi-runtime/airi-defaults.json;
    default_type application/json;
    add_header Cache-Control "no-cache";
  }

  location /models/ {
    include /etc/nginx/airi-cors.inc;
    alias /usr/share/nginx/models/;
    autoindex on;
    autoindex_format json;
    add_header Cache-Control "no-cache";
  }

  location /animations/ {
    include /etc/nginx/airi-cors.inc;
    alias /usr/share/nginx/animations/;
    autoindex on;
    autoindex_format json;
    add_header Cache-Control "no-cache";
  }

  # The same paths as the TalkingHead server, so a cmd/avatar/animation URL of the mirror loads here.
  location /animations_arkit/ {
    include /etc/nginx/airi-cors.inc;
    alias /usr/share/nginx/animations/animations_arkit/;
    add_header Cache-Control "no-cache";
  }

  location /poses/ {
    include /etc/nginx/airi-cors.inc;
    alias /usr/share/nginx/animations/poses/;
    add_header Cache-Control "no-cache";
  }

  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Single page app: every other path loads index.html. index.html itself is never cached.
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
  }
}
